# The local launcher loads this service's .env file.
DATABASE_URL=postgresql://movie:movie-local-password@127.0.0.1:5433/movie
MOVIE_DB_PASSWORD=movie-local-password
MOVIE_DB_PORT=5433

# Runtime tokens: separate from User Service admin reset token.
MOVIE_WRITE_TOKEN=
MOVIE_RESET_ENABLED=false
MOVIE_RESET_TOKEN=
USER_SERVICE_URL=http://127.0.0.1:4208
# Match User Service WATCHED_CLEANUP_TOKEN; limited to internal history cleanup.
WATCHED_CLEANUP_TOKEN=
# Optional absolute persistent directory; defaults to movie-service/assets/posters.
# MOVIE_MEDIA_DIR=/absolute/path/to/posters
# Ingestion only. Never used by runtime service.
TMDB_READ_TOKEN=
