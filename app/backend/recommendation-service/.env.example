# The local launcher loads this service's .env file.
DATABASE_URL=postgresql://recommendation:recommendation-local-password@127.0.0.1:5434/recommendation
RECOMMENDATION_DB_PASSWORD=recommendation-local-password
RECOMMENDATION_DB_PORT=5434

# Server-to-server credentials; never expose to the frontend.
RECOMMENDATION_API_TOKEN=
RECOMMENDATION_RESET_ENABLED=false
RECOMMENDATION_RESET_TOKEN=

# Internal Movie Service for available filter choices.
MOVIE_SERVICE_URL=http://127.0.0.1:4206

# Internal User Service context access; match its private context token.
USER_SERVICE_URL=http://127.0.0.1:4208
AGENT_CONTEXT_TOKEN=

# llama.cpp server (OpenAI-compatible) used to rerank candidates.
INFERENCE_SERVICE_URL=http://127.0.0.1:4210
