# The local launcher loads this service's .env file.
DATABASE_URL=postgresql://users:user-local-password@127.0.0.1:5435/users
# The local launcher defaults to false for HTTP; production defaults to true.
AUTH_COOKIE_SECURE=false
# Opt-in account-table reset endpoint. Keep disabled outside local development.
AUTH_RESET_ENABLED=false
AUTH_RESET_TOKEN=
USER_DB_PASSWORD=user-local-password
USER_DB_PORT=5435

# Internal catalog-reset cleanup only; match Movie Service WATCHED_CLEANUP_TOKEN.
WATCHED_CLEANUP_TOKEN=

# Internal Movie Service API for watch-time totals.
MOVIE_SERVICE_URL=http://127.0.0.1:4206

# Recommendation gateway. Match the Recommendation Service API token.
RECOMMENDATION_SERVICE_URL=http://127.0.0.1:4207
RECOMMENDATION_API_TOKEN=

# Private read-only token for external agent context access.
AGENT_CONTEXT_TOKEN=
