#!/usr/bin/env python3
"""Minimal kubectl simulator for the deploy-script tests: Deployments, a CronJob, Pods, the cd-state ConfigMap (optimistic locking)."""
import json, os, sys
SF = os.environ['SIM_STATE']; st = json.load(open(SF))
def save(): json.dump(st, open(SF, 'w'))
args = sys.argv[1:]
if args and args[0] == '-n': args = args[2:]
def opt(name):
    for i, a in enumerate(args):
        if a == name and i + 1 < len(args): return args[i + 1]
        if a.startswith(name + '='): return a.split('=', 1)[1]
dry = any(a.startswith('--dry-run') for a in args)
isbad = lambda n, img: (not img.startswith('g15-')) and n in st.get('bad_new', [])
LEG = st['legacy_cfg']
def pod_of(n):
    d = st['deploy'][n]; img = d['image']
    return {'metadata': {'name': n + '-0', 'deletionTimestamp': None}, 'status': {'containerStatuses': [{'ready': not isbad(n, img) and n not in st.get('unready', []), 'restartCount': 0,
            'imageID': LEG[n] if img.startswith('g15-') else img}]}}
def fail(msg): print(msg, file=sys.stderr); sys.exit(1)
cmd = args[0]
if cmd == 'auth':
    if args[1] == 'whoami': print('system:serviceaccount:g15-cd:ci-deployer'); sys.exit(0)
    res = args[3]; ok = res.startswith('deployment/') and res.split('/')[1] in ('frontend', 'proxy', 'user-service', 'movie-service', 'recommendation-service')
    print('yes' if ok else 'no'); sys.exit(0)
if cmd == 'get':
    kind = args[1]
    if kind == 'cm':
        print(json.dumps({'metadata': {'resourceVersion': str(st['cm']['rv'])}, 'data': st['cm']['data']})); sys.exit(0)
    if kind == 'pods':
        sel = opt('-l'); n = sel.split('=')[1]; print(json.dumps({'items': [pod_of(n)]})); sys.exit(0)
    if kind == 'deployment':
        n = args[2]
        if n not in st['deploy']: fail('NotFound')
        d = st['deploy'][n]; jp = opt('-o')
        if jp and jp.startswith('jsonpath='):
            if 'containers[0].image' in jp: print(d['image'], end=''); sys.exit(0)
            if 'generation' in jp: print(f"{d.get('gen', 1)}/{d.get('rv', 1)}", end=''); sys.exit(0)
        print(json.dumps({'spec': {'replicas': 1, 'selector': {'matchLabels': {'app': n}}}, 'status': {'readyReplicas': 0 if (isbad(n, d['image']) or n in st.get('unready', [])) else 1}})); sys.exit(0)
    if kind == 'cronjob':
        c = st['cron']; jp = opt('-o')
        if jp and jp.startswith('jsonpath='): print(c['image'], end=''); sys.exit(0)
        print(json.dumps({'spec': {'suspend': c['suspend'], 'schedule': c['schedule'], 'concurrencyPolicy': c['concurrencyPolicy'], 'jobTemplate': {'spec': {'template': {'spec': {'containers': [{'name': 'agent-scan', 'image': c['image'], 'env': [{'name': 'AGENT_MAX_QUEUED', 'value': c['maxq']}]}]}}}}}})); sys.exit(0)
if cmd == 'rollout':
    n = args[2].split('/')[1]
    import time
    if st.get('slow_rollout') and not st['deploy'][n]['image'].startswith('g15-') and not isbad(n, st['deploy'][n]['image']): time.sleep(st['slow_rollout'])
    if isbad(n, st['deploy'][n]['image']) or n in st.get('unready', []): fail(f'error: deployment "{n}" exceeded its progress deadline')
    sys.exit(0)
if cmd == 'patch':
    kind = args[1]; body = json.loads(opt('-p'))
    if kind == 'cm':
        want = body.get('metadata', {}).get('resourceVersion')
        if st.get('conflict_on_lock') and want: fail('Error from server (Conflict): the object has been modified')
        if want and str(want) != str(st['cm']['rv']): fail('Error from server (Conflict): the object has been modified')
        st['cm']['data'].update(body.get('data', {})); st['cm']['rv'] += 1; save(); sys.exit(0)
    n = args[2]
    if st.get('deny_patch') == n: fail(f'admission webhook denied the request: ValidatingAdmissionPolicy denied {n}')
    pod = body['spec']['template']['spec'] if kind == 'deployment' else body['spec']['jobTemplate']['spec']['template']['spec']
    tgt = st['deploy'][n] if kind == 'deployment' else st['cron']
    c = pod['containers'][0]
    comp = 'recommendation-service' if kind == 'cronjob' else n          # emulate the cluster's admission policy
    okimg = c['image'] == f'g15-{comp}:local' or (f'/{comp}@sha256:' in c['image'] and c['image'].startswith('registry.rnl.tecnico.ulisboa.pt/psia/groups26/g15/'))
    if not okimg: fail('ValidatingAdmissionPolicy denied the request: image not allowed for ' + comp)
    if not dry:
        hf = os.environ.get('SIM_HEALTH_FAIL')
        if hf and os.path.exists(hf) and c['image'].startswith('g15-'): os.remove(hf)       # the legacy image is healthy again
        tgt['image'] = c['image']; tgt['pullPolicy'] = c['imagePullPolicy']; tgt['secrets'] = pod.get('imagePullSecrets') or []
        st['patch_count'] = st.get('patch_count', 0) + 1
        if st.get('inference_bump_after') and st['patch_count'] >= st['inference_bump_after']: st['deploy']['inference']['rv'] += 1
        save()
    sys.exit(0)
fail('unsupported: ' + ' '.join(args))
